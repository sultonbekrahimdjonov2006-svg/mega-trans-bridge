# REQUIRED — PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_fashion

# DEVELOPMENT ONLY — omit for guest mode
DEV_USER_ID=

# OPTIONAL — OpenAI Seller (server only)
REAL_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
AI_REQUEST_TIMEOUT_MS=15000

# OPTIONAL — private image storage adapter
IMAGE_STORAGE_DRIVER=memory
IMAGE_MAX_BYTES=8388608
IMAGE_RETENTION_HOURS=24

# OPTIONAL — VTO remains mock-only until a provider is reviewed
VTO_PROVIDER=mock
VTO_REQUEST_TIMEOUT_MS=30000
